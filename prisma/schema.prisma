generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String   
  company   String?
  message   String?
  status    String   @default("New")
  createdAt DateTime @default(now())
}